define("idauto-core-ui/utils/ajax", ["exports", "ember"], function (exports, _ember) {
    "use strict";

    exports["default"] = {
        setup: function setup(token, errors) {
            _ember["default"].$(document).on("ajaxStart.idauto", function () {
                //Ember.$('.app-loading').removeClass('hide');
            });
            _ember["default"].$(document).on("ajaxComplete.idauto", function () {
                //Ember.$('.app-loading').addClass('hide');
            });
            _ember["default"].$(document).on("ajaxSend.idauto", function (e, xhr) {
                // add token to all ajax request headers
                xhr.setRequestHeader('Authorization', "Bearer " + token);
            });

            _ember["default"].$(document).on("ajaxError.idauto", function (event, xhr) {
                if (xhr.status === 401) {
                    // assume auth token is expired
                    errors.invalidAuthToken();
                } else if (xhr.status === 503 && xhr.responseJSON.errorCode === 'maintenance_mode') {
                    // this means the server is in maintenance mode, let the user know before
                    errors.uiUnavailable(xhr.responseJSON.message);
                } else if (xhr.status >= 402 || xhr.status <= 500) {
                    var msg = xhr.statusText + ': ' + (xhr.responseJSON ? xhr.responseJSON.message : '') + ' ' + (xhr.responseJSON ? xhr.responseJSON.details : '');
                    errors.logError('Status code ' + xhr.status + ' recieved from ajax call.\n\n' + msg, errors.SEVERE);
                } else if (xhr.status === 0) {
                    // this will only happen if the browser blocks an api call due to a security issue,
                    // you may need to add a security exception for the self signed cert in your browser
                    errors.logError('Status code 0 recieved from ajax call.  This can happen if the browser blocks the request that violates a security policy.', errors.SEVERE);
                }
            });
        },

        tearDown: function tearDown() {
            _ember["default"].$(document).off("ajaxStart.idauto ajaxComplete.idauto ajaxSend.idauto ajaxError.idauto");
        }
    };
});
