            this.set('dataType', 'data-type-' + componentType);
            this.set('inputComponentType', 'form-builder/editable-attributes/' + componentType);
            this.set('showLabel', this.get('showLabel') !== false);
            this.set('isMulti', galItem.get('allowMultiValue'));
            this.set('limitHeight', galItem.get('limitHeight'));

            var values = model.get('values').toArray();

            if (values.length === 0) {
                if (this.get('isEditing')) {
                    // if editing must have one value
                    values.pushObject("");
