            var componentType = undefined;
            var galItem = model.get('galItem');

            switch (galItem.get('iType')) {
                case 'BOOLEAN':
                case 'ACCOUNT_DISABLED':
                case 'ACCOUNT_LOCKED':
                    componentType = 'boolean';
                    break;
                case 'DATE':
                case 'DATE_STRING':
                case 'DATE_TIME':
                    componentType = 'datetime';
                    break;
                case 'EMAIL':
                    componentType = 'text';
                    break;
                case 'PHONE':
                    componentType = 'text';
                    break;
                case 'NUMBER':
                    componentType = 'text';
                    break;
                case 'STRING':
                    componentType = 'text';
                    break;
                case 'PASSWORD':
                    componentType = 'password';
                    break;
                case 'MULTI_LINE_STRING':
                    componentType = 'multi-line';
                    break;
                case 'BINARY_IMAGE':
                case 'URL_IMAGE':
                    componentType = 'image';
                    break;
                case 'DYNAMIC_LIST':
                    componentType = 'dynalist';
                    break;
                case 'LIST':
                    componentType = 'list';
                    break;
                case 'PERSON_CHOOSER':
                    componentType = 'person-chooser';
                    break;
                case 'LDAP_FILTER':
                    componentType = 'ldap-filter';
                    break;
                case 'DN':
                    componentType = 'dn';
                    break;
                default:
                    return;
