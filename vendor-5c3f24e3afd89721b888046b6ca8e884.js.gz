     */

    'use strict';

    exports['default'] = _emberData['default'].Model.extend({
        section: _emberData['default'].attr('string'),
        dn: _emberData['default'].attr('string'),
        rdn: _emberData['default'].attr('string'),
        ldapContainers: _emberData['default'].hasMany('ldap/ldap-container'),
        children: _emberData['default'].attr(),
        expanded: _emberData['default'].attr('boolean', { defaultValue: false }),
        childrenLoaded: _emberData['default'].attr('boolean', { defaultValue: false }),
        label: _ember['default'].computed('dn', function () {
            if (this.get("rdn")) {
                return this.get("rdn");
            }
            return "ROOT";
        }),
        loadChildren: function loadChildren() {
            var model = this;
            var store = this.get("store");
            var section = this.get("section");
            model.set("childrenLoaded", true);
            this.get("ldapContainers").forEach(function (ldapContainer) {
                var dn = ldapContainer.get("rdn");
                if (model.get("dn")) {
                    dn += "," + model.get("dn");
                }
                store.queryRecord('ldap/ldap-container-list', { section: section, dn: dn }).then(function (container) {
                    container.set("rdn", ldapContainer.get("rdn"));
                    container.set("section", section);
                    var children = model.get("children");
                    if (children) {
                        children.pushObject(container);
                    } else {
                        model.set("children", [container]);
                    }
                    if (model.get("expanded")) {
                        container.loadChildren();
                    }
                });
            });
        }
    });
});
