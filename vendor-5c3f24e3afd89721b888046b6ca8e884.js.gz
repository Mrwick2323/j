                    // hide attrs with no values unless editing, except for image which has a placeholder
                    this.set('hide', true);
                }
            } else if (componentType === 'person-chooser') {
                // if we are a person chooser, alphabetize the values
                values.sort(function (a, b) {
                    var aName = a.get('firstName');
                    if (aName) {
                        aName = aName.toString().toLowerCase();
                    } else {
                        return -1;
                    }

                    var bName = b.get('firstName');
                    if (bName) {
                        bName = bName.toString().toLowerCase();
                    } else {
                        return 1;
                    }
                    if (aName !== bName) {
                        return aName.localeCompare(bName);
                    }

                    // first names are equal, check last name
                    aName = a.get('lastName');
                    bName = b.get('lastName');
                    if (aName) {
                        aName = aName.toString().toLowerCase();
                    } else {
                        return -1;
                    }
                    if (bName) {
                        bName = bName.toString().toLowerCase();
                    } else {
                        return 1;
                    }

